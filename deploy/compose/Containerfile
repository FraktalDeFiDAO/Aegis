# Multi-stage build so the runtime image stays minimal.
FROM docker.io/library/golang:1.25 AS builder

WORKDIR /src
COPY go.mod go.sum ./
# Install goimports
RUN go install golang.org/x/tools/cmd/goimports@latest

COPY . .
# Optimize imports and manage dependencies
RUN go mod tidy && go mod vendor
RUN goimports -w .

RUN CGO_ENABLED=0 go build -mod=vendor -o /agent/bin/aegis ./cmd/aegis/

FROM registry.fedoraproject.org/fedora:41
RUN dnf -y install \
    alsa-lib \
    at-spi2-atk \
    atk \
    cairo \
    ca-certificates \
    cups-libs \
    dbus-glib \
    glib2 \
    gtk3 \
    libX11 \
    libXcomposite \
    libXcursor \
    libXdamage \
    libXext \
    libXfixes \
    libXi \
    libXrandr \
    libXrender \
    libXScrnSaver \
    libXtst \
    libxcb \
    libxkbcommon \
    libxkbcommon-x11 \
    libdrm \
    mesa-libgbm \
    nss \
    pango \
    xorg-x11-fonts-Type1 \
    xorg-x11-fonts-misc \
  && dnf clean all \
  && rm -rf /var/cache/dnf

COPY --from=builder /agent/bin/aegis /usr/local/bin/aegis

ENTRYPOINT ["/usr/local/bin/aegis"]
