{
  "manifest_version": 2,
  "name": "Aegis Browser Connector",
  "description": "Bridges Aegis security scanner to your live browser session",
  "version": "1.1.2",
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation",
    "cookies",
    "storage",
    "alarms",
    "notifications",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "browser-control.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
}
